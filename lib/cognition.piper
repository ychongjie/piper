;; 认知层(llm)= 编排器的"脑子":纯、便宜、返回值、无副作用。
;; 它只看你喂进 prompt 的东西——这是它和执行层(pi)的边界。
;;
;; 边界规则(重要):
;;   认知层【不碰环境】。需要参考本地代码时,由控制平面 (read-files …) 把代码读出来
;;   拼进 prompt;若"该看哪些代码"本身需要探索(grep/跟引用),那不是认知,
;;   而是派执行层 (agent …) 去做。
;;
;; 认知 worker:绑定到某模型的一次补全。worker = (lambda (task) -> 文本)。
;; (ask 在 prelude:用默认模型;judge/propose 是 ask/llm-code 之上的常用包装,
;;  本身可当 best 的 score、amb* 的候选,与控制平面咬合。)

(define (model name) (lambda (task) (llm task "" name)))

;; 给内容按某标准打 0-10 分(给 best 当 score);解析失败记 0
(define (judge criterion x)
  (let ((n (string->number (string-trim
             (ask (string-append
                   "按【" criterion "】给下面内容打一个 0 到 10 的整数分,只输出数字:\n"
                   (->string x)))))))
    (if n n 0)))

;; 就一个任务生成 n 个互不相同的候选(给 amb* 当搜索空间),返回一个 list
(define (propose n task)
  (eval (llm-code (string-append
                   "针对任务【" task "】给出 " (number->string n)
                   " 个互不相同的候选,返回一个 Scheme list,每个元素是字符串。"))))
