;; 自我生长的活程序:用对话给自己写新能力,装进运行时镜像,能力越用越多、可组合。
;; 让语言机制当主角(而非"调一次 LLM"):
;;   - 同像性:把自己现有技能的源码喂回 LLM(skills->string 用 procedure-source)
;;   - 自修改 + 复利:新技能 eval 进全局镜像,且可调用早先长出来的技能(组合)
;;   - 事务安全:新技能先测试,不过就 capture/restore 回滚,镜像不被污染
;;   - 自纠错:失败把错误喂回,重试

;; 技能注册表:((name . description) ...);实际过程绑定在全局,按 name 可调用
(define *skills* '())

(define (skill-names) (map car *skills*))

;; 同像性自省:把"我现在会什么 + 它们的源码"渲染出来喂给 LLM
(define (skills->string)
  (if (null? *skills*)
      "  (暂无)\n"
      (foldl (lambda (s acc)
               (string-append acc
                 "  " (symbol->string (car s)) " —— " (cdr s) "\n"
                 "    源码: " (repr (procedure-source (eval (car s)))) "\n"))
             "" *skills*)))

(define (learn-prompt name description last-err)
  (string-append
   "你是一个 Lisp 程序,正在为自己扩充能力。\n"
   "你已有以下技能(可直接按名字调用,鼓励复用与组合,不要重复造轮子):\n"
   (skills->string)
   "\n现在请新增一个名为 " (symbol->string name) " 的过程,功能:" description "\n"
   (if (string=? last-err "")
       ""
       (string-append "上次尝试不对:" last-err "。请据此修正。\n"))
   "只返回一个 (define (" (symbol->string name) " ...) ...) 形式的 s-expression,"
   "可调用上面已有技能;不要解释、不要 markdown 围栏。"))

;; learn! :让程序给自己写并装上一个新技能 name,test-ok? 通过才纳入(否则回滚)。
;; 最多重试 tries 次,每次把失败原因喂回。返回 'learned | 'failed。
(define (learn! name description test-ok? tries)
  (define (round n last-err)
    (define ckpt (capture))                       ; 事务起点
    (define attempt
      (try (lambda ()
             (eval (llm-code (learn-prompt name description last-err)))  ; 写入镜像
             (test-ok?))))                          ; 现场验收(可能抛错)
    (cond
      ((and (eq? (car attempt) 'ok) (cdr attempt)) ; 验收通过 -> 纳入注册表(保留)
       (set! *skills* (append *skills* (list (cons name description))))
       (display "  ✓ 学会 ") (display name) (newline)
       'learned)
      ((>= n tries)                                ; 用尽 -> 回滚,镜像不被污染
       (restore ckpt)
       (display "  ✗ 放弃 ") (display name) (newline)
       'failed)
      (else                                        ; 失败 -> 回滚 + 把错误喂回重试
       (define err (if (eq? (car attempt) 'ok) "测试未通过" (cdr attempt)))
       (restore ckpt)
       (display "  … 重试 ") (display name) (display " (") (display err) (display ")") (newline)
       (round (add1 n) err))))
  (round 1 ""))
