;; Piper 标准库前奏(用 Piper 自身编写,以此检验求值器)。
;; M0:列表与高阶工具。后续里程碑会在此基础上加 ask/amb/goal/loop 等。

(define (map f xs)
  (if (null? xs)
      '()
      (cons (f (car xs)) (map f (cdr xs)))))

(define (for-each f xs)
  (if (null? xs)
      #t
      (begin (f (car xs)) (for-each f (cdr xs)))))

(define (foldl f acc xs)
  (if (null? xs)
      acc
      (foldl f (f (car xs) acc) (cdr xs))))

(define (foldr f acc xs)
  (if (null? xs)
      acc
      (f (car xs) (foldr f acc (cdr xs)))))

(define (length xs)
  (if (null? xs) 0 (add1 (length (cdr xs)))))

(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))

(define (reverse xs)
  (foldl cons '() xs))

(define (filter p xs)
  (cond ((null? xs) '())
        ((p (car xs)) (cons (car xs) (filter p (cdr xs))))
        (else (filter p (cdr xs)))))

(define (member x xs)
  (cond ((null? xs) #f)
        ((equal? x (car xs)) xs)
        (else (member x (cdr xs)))))

(define (assoc k xs)
  (cond ((null? xs) #f)
        ((equal? k (caar xs)) (car xs))
        (else (assoc k (cdr xs)))))

(define (range n)
  (define (go i) (if (>= i n) '() (cons i (go (add1 i)))))
  (go 0))

(define (last xs)
  (if (null? (cdr xs)) (car xs) (last (cdr xs))))

;; 常用控制宏(用 define-macro 长出来,核心保持小)
(define-macro (when c . body)   (list 'if c (cons 'begin body) #f))
(define-macro (unless c . body) (list 'if c #f (cons 'begin body)))

;; ---- M2:LLM 接入 ----
;; (llm prompt) / (llm-code prompt) / (eval expr) 是原语;这里加便捷封装。

(define (ask q) (llm q))            ; 自然语言问答,返回字符串

(define (gen prompt) (eval (llm-code prompt)))  ; LLM 生成 s-expr 并立即运行
