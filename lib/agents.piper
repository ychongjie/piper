;; 执行层(pi)= 被派出去的自主 agent。
;; 重、慢、有自己的工具(read/bash/...)+ 自己的循环 + 副作用,在真实环境里【完成任务】。
;; 这才是被编排的 actor/worker。与认知层(llm,见 lib/cognition.piper)是两个不同层级:
;;   认知层用来【想】(派谁、怎么判、何时回溯),执行层用来【干】。
;;
;; 范式:认知层编排执行层 —— 见下方桥接组合子。
;;
;; 前置:pi 需要自己的 provider/key。推荐用 Custom Provider 指到你现有的开源端点
;; (如 SiliconFlow),复用开源模型、不用新 key。详见 README「执行层(pi)配置」。

(define *agent-provider* "siliconflow")               ; pi models.json 里的自定义 provider 名
(define *agent-model*    "deepseek-ai/DeepSeek-V4-Pro")
(define *agent-tools*    "read,bash")                  ; 能力白名单(交给 pi)

;; agent:在工作目录 dir 里派一个 pi 子 agent 去完成 task。
;; 返回 (退出码 . 输出)。重:自带工具+循环+副作用。
(define (agent dir task)
  (shell (string-append
          "cd " (shell-quote dir)
          " && pi -p --no-session --mode text"
          " --provider " *agent-provider* " --model " *agent-model*
          " --tools " *agent-tools* " "
          (shell-quote task))))

;; ---- 桥接:认知层编排执行层 ----

(define (agent-ok? outcome) (= (car outcome) 0))           ; 退出码 0 = 跑通

;; 用认知层校验一个执行结果是否达标(criterion 由 llm 裁判)
(define (verify outcome criterion) (>= (judge criterion (cdr outcome)) 7))

;; 派 n 个 agent 各做一版,用认知层裁判按 criterion 择优(执行层 fan-out + 认知层选优)
(define (best-agent dir task n criterion)
  (best-of (map (lambda (i) (lambda () (agent dir task))) (range n))
           (lambda (o) (judge criterion (cdr o)))))

;; 把一组子任务各派一个 agent 去做(拆解 + 执行层 fan-out)
(define (dispatch-all dir tasks) (map (lambda (t) (agent dir t)) tasks))

;; 其它厚 harness(claude/codex)可同样包成 agent;但锁厂商/计费,默认不用。
