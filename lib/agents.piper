;; 执行层(pi)= 被派出去的自主 agent:重、有自己的工具(read/bash/…)+ 循环 + 副作用,
;; 在真实环境里【完成任务】。worker = (lambda (task) -> (退出码 . 输出))。
;;
;; 与认知层(llm)是不同层级:认知层【想】(派谁、怎么判、何时回溯),执行层【干】。
;; 范式:认知层编排执行层 —— 把 (agent dir) 当 worker 喂进 fan-out/best/vote/amb 即可。
;;
;; 前置:pi 需配 provider。推荐 Custom Provider 指到现有开源端点(如 SiliconFlow),
;; 密钥写在 ~/.pi/agent/models.json(仓库之外)。详见 README「执行层(pi)配置」。

(define *agent-provider* "siliconflow")
(define *agent-model*    "deepseek-ai/DeepSeek-V4-Pro")
(define *agent-tools*    "read,write,edit,bash")   ; 交给 pi 的能力白名单(编码 agent 需写/改)

;; 双模式:(agent dir) 当 worker;(agent dir 任务) 直接派一次(省双层括号)。
;; env -u 剥 *_proxy(httpx 走 SOCKS 需 socksio,直连更省事,与 llm 一致)。
(define (agent dir . task)
  (define (run t)
    (shell (string-append
            "cd " (shell-quote dir)
            " && env -u all_proxy -u http_proxy -u https_proxy"
            " pi -p --no-session --mode text"
            " --provider " *agent-provider* " --model " *agent-model*
            " --tools " *agent-tools* " "
            (shell-quote t))))
  (if (null? task) (lambda (t) (run t)) (run (car task))))
