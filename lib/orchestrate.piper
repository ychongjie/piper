;; 控制平面:对 worker 类型一视同仁。worker = (lambda (task) -> 结果)。
;; worker 由两个构造器产生:认知 worker (model …,见 cognition.piper)、
;; 执行 worker (agent …,见 agents.piper)。回溯用 amb/require,迭代用 loop。

;; fan-out:让一组 worker 都做同一个 task,收集全部结果
(define (fan-out workers task) (map (lambda (w) (w task)) workers))

;; best:一组 worker 各做一版,取最优。
;; score 可以是函数 (结果->数),也可以直接是一个【标准字符串】(自动用 judge 打分)。
(define (best workers task score)
  (best-by (fan-out workers task)
           (if (string? score) (lambda (r) (judge score r)) score)))

;; vote:一组 worker 各做一版,equal? 相同的归一类,取票数最多的结果
(define (vote workers task) (car (best-by (tally (fan-out workers task)) cdr)))

;; ---- 内部小工具 ----

;; 按 score 取最高分的元素(每个元素只算一次,适合 score 调 LLM)
(define (best-by items score)
  (if (null? items)
      #f
      (let ((scored (map (lambda (x) (cons x (score x))) items)))
        (car (foldl (lambda (p b) (if (> (cdr p) (cdr b)) p b))
                    (car scored) (cdr scored))))))

;; 计数:返回 ((值 . 次数) ...)
(define (tally xs)
  (foldl (lambda (x acc)
           (let ((cell (assoc x acc)))
             (if cell
                 (map (lambda (c) (if (equal? (car c) x) (cons (car c) (add1 (cdr c))) c)) acc)
                 (cons (cons x 1) acc))))
         '() xs))

;; shell-ok?:命令成功(退出码 0)?取代啰嗦的 (= 0 (car (shell cmd)))
(define (shell-ok? cmd) (= 0 (car (shell cmd))))

;; 上下文助手:控制平面读本地代码,拼成一段(供喂进认知层 prompt)。
;; 边界规则:认知层(llm)不碰环境;要参考本地代码就先 read-files 再塞进 prompt。
(define (read-files paths)
  (foldl (lambda (p acc)
           (string-append acc "\n===== " p " =====\n" (read-file p) "\n"))
         "" paths))
