;; M6:事务性自修改助手(纯库代码,建在 redefine! / capture / restore /
;; procedure-source / llm-code 之上)。DESIGN §8.5、§9。

;; improve! :用 LLM 重写 name 当前指向的过程,冒烟测试不过则整体回滚。
;;   name        被改过程的符号(如 'area)
;;   instruction 自然语言改写要求
;;   smoke-ok?   0 参谓词,返回真表示新实现可接受
;; 返回 'kept | 'rolled-back。无论结果如何,这次尝试都会进 redefine-log。
(define (improve! name instruction smoke-ok?)
  (define ckpt (capture))
  (define old-src (procedure-source (eval name)))
  (define new-impl
    (eval (llm-code
           (string-append
            instruction "\n"
            "下面是当前实现。请只返回一个改进后的 lambda(单个 s-expression,"
            "不要解释、不要 markdown):\n"
            (repr old-src)))))
  (redefine! name new-impl (string-append "improve!: " instruction))
  ;; 用 try 包冒烟:返回假 **或** 抛错都算失败 -> 回滚
  (define smoke (try smoke-ok?))
  (if (and (eq? (car smoke) 'ok) (cdr smoke))
      'kept
      (begin (restore ckpt) 'rolled-back)))

;; with-checkpoint :在事务里跑 thunk,thunk 返回假则回滚。返回 thunk 的结果。
(define (with-checkpoint thunk)
  (define ckpt (capture))
  (define result (thunk))
  (if result result (begin (restore ckpt) #f)))

;; ---- 失败驱动的自进化 ----

;; 跑一套用例,返回失败记录 ((输入 期望 实际) ...)。
;; 用 try 包裹调用:函数抛错时实际记为 (ERROR msg),照样算失败、喂回给 LLM。
;; cases 形如 ((输入 期望) ...);f 是单参函数。
(define (suite-failures f cases)
  (foldr
   (lambda (c acc)
     (define r (try (lambda () (f (car c)))))
     (define got (if (eq? (car r) 'ok) (cdr r) (list 'ERROR (cdr r))))
     (if (equal? got (cadr c))
         acc
         (cons (list (car c) (cadr c) got) acc)))
   '() cases))

(define (failures->string fs)
  (foldl (lambda (f acc)
           (string-append acc
             "  输入 " (repr (car f))
             "  期望 " (repr (cadr f))
             "  实际 " (repr (caddr f)) "\n"))
         "" fs))

;; evolve! :让 name 指向的函数在一整套用例上自我进化(带 LLM 变异的爬山法)。
;;   name        被进化函数的符号
;;   cases       ((输入 期望) ...) 完整测试表(确定性适应度)
;;   instruction 自然语言任务说明(应说清函数签名)
;;   rounds      最多迭代轮数
;; 每轮:把"当前源码 + 当前失败的具体用例"喂给 LLM 要新实现;只保留严格减少失败数
;; 的版本(退步则 restore 回滚)。返回 (evolved n) | (partial 剩余失败数 失败表)。
(define (evolve! name cases instruction rounds)
  (define (go r best)
    (cond
      ((null? best) (list 'evolved (sub1 r)))
      ((> r rounds)  (list 'partial (length best) best))
      (else
       (define ckpt (capture))
       (define src (procedure-source (eval name)))
       ;; 整轮(生成→解析→重定义→测试)用 try 兜住:候选无法解析/求值也只是无效轮
       (define attempt
         (try (lambda ()
                (redefine! name
                  (eval (llm-code
                         (string-append
                          instruction "\n"
                          "当前实现:\n" (repr src) "\n"
                          "它在下列用例上不正确(输入 / 期望 / 实际):\n" (failures->string best)
                          "请修正。只返回一个改进后的 lambda(单个 s-expression,"
                          "不要解释、不要 markdown 围栏)。")))
                  "evolve!")
                (suite-failures (eval name) cases))))
       (define fs (if (eq? (car attempt) 'ok) (cdr attempt) best))  ; 失败轮视作没进步
       (display "  [evolve] 第 ") (display r) (display " 轮:失败 ")
       (display (length best)) (display " -> ") (display (length fs))
       (if (eq? (car attempt) 'ok) #t (display " (候选无效,跳过)")) (newline)
       (if (< (length fs) (length best))
           (go (add1 r) fs)                         ; 严格进步 -> 保留,继续
           (begin (restore ckpt) (go (add1 r) best)))))) ; 退步/持平/无效 -> 回滚
  (go 1 (suite-failures (eval name) cases)))
