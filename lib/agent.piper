;; M4:goal —— LLM 驱动的目标循环(观察 → 生成下一步 → eval → 检查成功)。
;; 三层模型(DESIGN §5.3):
;;   L2  goal-run   普通过程(driver),建在 llm-code / eval-in / capture / restore 之上
;;   L3  goal       一层薄宏,把 clause 语法糖展开成 goal-run 调用
;; 全部可被 redefine!。能力白名单由 eval-in 强制(LLM 生成的代码只能碰 tools)。

;; ---- prompt 渲染 ----

(define (tool-names->string tools)
  (if (null? tools)
      "(无)"
      (foldl (lambda (pair acc)
               (string-append acc " " (symbol->string (car pair))))
             "" tools)))

(define (history->string history)
  (if (null? history)
      "  (空)\n"
      (foldl (lambda (entry acc) (string-append acc "  " (repr entry) "\n"))
             "" (reverse history))))

(define (goal-render desc tools history)
  (string-append
   "你是一个 agent,正在通过调用工具一步步达成目标。\n"
   "目标:" desc "\n"
   "可用工具(每步只能调用这些,不能用其它函数):" (tool-names->string tools) "\n"
   "已执行历史(格式 (步号 调用 => 结果),最早在上):\n" (history->string history)
   "请只输出下一步:一个 Scheme s-expression(调用上面的工具),"
   "不要解释、不要 markdown 围栏。\n下一步:"))

;; ---- L2:driver ----

;; desc       目标描述(字符串)
;; success?   0 参谓词,返回真表示达成
;; tools      ((name . proc) ...) 能力白名单
;; max-steps  步数上限
;; 返回 (success <history>) 或 (exhausted <history>)
(define (goal-run desc success? tools max-steps)
  (define history '())
  (define (record! entry) (set! history (cons entry history)))
  (define (step-loop n)
    (cond
      ((success?)     (list 'success (reverse history)))
      ((> n max-steps)(list 'exhausted (reverse history)))
      (else
       (define step (llm-code (goal-render desc tools history)))
       (define ckpt (capture))                 ; 每步前快照,失败可回滚
       (define outcome (eval-in step tools))   ; 沙箱执行:(ok . v) | (err . msg)
       (if (eq? (car outcome) 'ok)
           (record! (list n step '=> (cdr outcome)))
           (begin (restore ckpt)               ; 出错:回滚副作用,LLM 据历史重试
                  (record! (list n step 'ERR (cdr outcome)))))
       (display "  [goal] step ") (display n) (display ": ")
       (display (repr step)) (display "  -> ") (display (cdr outcome)) (newline)
       (step-loop (add1 n)))))
  (step-loop 1))

;; ---- L3:薄宏(clause 语法糖)----
;; (goal "desc"
;;   (success? <expr>)      ; 求值出一个 0 参谓词
;;   (tools <expr>)         ; 求值出 ((name . proc) ...)
;;   (max-steps <n>))

(define (goal-clause clauses key default)
  (let ((c (assoc key clauses)))
    (if c (cadr c) default)))

(define-macro (goal desc . clauses)
  (list 'goal-run
        desc
        (goal-clause clauses 'success?  '(lambda () #f))
        (goal-clause clauses 'tools     ''())
        (goal-clause clauses 'max-steps 10)))
