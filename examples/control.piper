;; M1 示例:一等 continuation + 状态检查点。
;; 运行:make run FILE=examples/control.piper

;; 1) call/cc 做非局部退出:找到第一个满足谓词的元素就立刻返回
(define (find-first pred xs)
  (call/cc (lambda (return)
    (for-each (lambda (x) (if (pred x) (return x) #f)) xs)
    'not-found)))

(display "first even > 3: ")
(display (find-first (lambda (x) (and (> x 3) (= 0 (modulo x 2)))) (range 20)))
(newline)

;; 2) capture / restore 做事务性"自修改":
;;    重定义 area,冒烟测试不过 -> 回滚到改之前。
(define (area r) (* 3 (* r r)))          ; 故意用错的 π≈3
(display "area before: ") (display (area 10)) (newline)   ; 300

(define cp (capture))                     ; 抓快照
(define (area r) (* 100 r))               ; 一次"改坏了"的自修改
(define (smoke-ok?) (= (area 10) 300))    ; 冒烟:期望 area(10)=300
(if (smoke-ok?)
    (display "patch kept\n")
    (begin (restore cp) (display "patch rolled back\n")))

(display "area after:  ") (display (area 10)) (newline)   ; 回滚后仍是 300
