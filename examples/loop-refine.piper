;; loop 示例(自定步):让模型反复改进一句标语,直到裁判打分达标或到上限。
;; 运行:make run FILE=examples/loop-refine.piper
;; 核心词:loop (self-paced) —— body 返回 (continue)/(stop v) 自己决定是否继续。

(define topic "一个帮开发者管理 API 密钥的小工具")
(define draft (ask (fmt "给「{}」写一句产品标语,简短有力,只输出标语本身" topic)))
(define tries 0)

(define final
  (loop (self-paced)
    (set! tries (add1 tries))
    (define score (judge "吸引人、简洁、点明价值" draft))
    (display (fmt "  [{} 分] {}\n" score draft))
    (if (or (>= score 8) (>= tries 4))
        (list 'stop draft)                                       ; 达标 / 到上限 → 停
        (begin (set! draft (ask (fmt "把这句标语改得更吸引人、更短,只输出标语:{}" draft)))
               (list 'continue)))))                              ; 否则继续改

(newline)
(display (fmt "定稿:{}\n" final))
