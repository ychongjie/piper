;; 竞争式修 bug(完整、可跑):开 N 个隔离副本,各派一个 pi agent 去修,
;; 按【真实测试通过数】择优,胜者提交。需要 pi(执行层)+ python3。
;; 运行:make run FILE=examples/fix-compete.piper
;;
;; 看点:模型只当 worker(各修一版);语言做控制平面——隔离、真实度量、择优、提交。
;; 关键:不信 agent 的自我汇报,每个候选都【重新跑真实测试】打分。

(define src  "examples/buggy")        ; 仓库里的原始(只读参考,绝不被改)
(define base "/tmp/fix-base")         ; /tmp 工作副本(避免动到仓库)
(define n    3)                       ; 竞争者数量

;; 真实反馈:在某目录跑 check.py,返回通过数(check.py 只打印一个整数)
(define (passed dir)
  (string->number (string-trim (cdr (shell (fmt "cd {} && python3 check.py" dir))))))

;; 一个竞争者:复制隔离副本 → 派 agent 修 → 重新跑真实测试 → 返回 (通过数 . 副本目录)
(define (contender i)
  (define work (fmt "/tmp/fix-{}" i))
  (shell (fmt "rm -rf {} && cp -r {} {}" work base work))
  (agent work "修改 solution.py 使 check.py 输出的通过数尽量大;不要改 check.py")
  (define score (passed work))
  (display (fmt "  竞争者 {}:通过 {}\n" i score))
  (cons score work))

;; 准备工作副本(仓库原文件保持不变)
(shell (fmt "rm -rf {} && cp -r {} {}" base src base))
(display (fmt "修复前通过:{} / 7\n" (passed base)))

;; 开 N 个竞争者(各自隔离),按通过数择优
(display (fmt "派 {} 个 agent 竞争修复…\n" n))
(define results (map contender (range n)))
(define winner  (best-by results car))      ; (通过数 . 目录) 里通过数最高的

;; 胜者提交回工作副本
(shell (fmt "cp {}/solution.py {}/solution.py" (cdr winner) base))
(newline)
(display (fmt "胜出副本:{}(通过 {} / 7)\n" (cdr winner) (car winner)))
(display (fmt "提交后通过:{} / 7\n" (passed base)))
