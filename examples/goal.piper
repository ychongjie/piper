;; M4 真实端到端示例:LLM 驱动的 goal 循环(需要 llm CLI,默认 deepseek-v4-pro)。
;; 运行:make run FILE=examples/goal.piper
;;
;; 玩具任务:把 total 从 0 累加到 30,每次只能调用 add,且单次最多加 10。
;; LLM 必须分多步、看着历史里的当前值,自己规划 (add 10) (add 10) (add 10)。
;; 能力白名单:LLM 生成的代码只能调用 add —— 想直接 (set! total 30) 会被沙箱拦下。

(define total 0)

(define (add n)
  (if (> n 10)
      (error "单次最多加 10")
      (begin (set! total (+ total n)) total)))

(define result
  (goal "把 total 累加到正好 30"
    (success?  (lambda () (= total 30)))
    (tools     (list (cons 'add add)))
    (max-steps 12)))

(newline)
(display "结果:") (display (car result)) (newline)
(display "total = ") (display total) (newline)
