;; ===== Piper 编排核心词汇一览(精简后)=====
;; 加载本文件只是定义这些过程,不会真跑(要跑需 llm/pi/sandbox)。
;; 核心约定:worker = (lambda (task) -> 结果);只有 model / agent 两个构造器;
;; 控制平面 fan-out / best / vote / amb / loop 对 worker 类型一视同仁。

;; 1. 多模型合议(纯认知层):fan-out 一组 model,标准字符串直接当 score
(define (ask-panel q)
  (best (map model '("deepseek-v4-pro" "kimi2.6" "deepseek-v4-flash"))
        q
        "准确且简洁"))

;; 2. 竞争式执行(认知编排执行):3 个 agent 各做一版,judge 看输出择优
(define (compete dir task)
  (best (map (lambda (_) (agent dir)) (range 3))
        task
        (lambda (o) (judge "实现正确、改动最小" (cdr o)))))

;; 3. 回溯搜索(认知提候选 + 执行做 + 真实验证 + amb 回溯)
(define (search-impl dir task check)
  (define idea (amb* (propose 4 task)))               ; 认知层给 4 个思路,选其一
  (agent dir (fmt "按这个思路实现:{}" idea))           ; 执行层照做(直接派一次)
  (require (shell-ok? check))                          ; 真实验证;失败 → 回溯换思路
  idea)

;; 4. 迭代直到真实达标(loop + 真实反馈 + 每轮竞争择优)
(define (fix-until-green dir)
  (define (green?) (shell-ok? (fmt "cd {} && python3 -m pytest -q" dir)))
  (loop (until (green?))
    (compete dir "修改 solution.py 让 test_solution.py 全过,不要动测试文件"))
  'all-green)

;; 5. 参考本地代码再提方案(边界规则:控制平面 read-files,认知层 propose)
(define (suggest-fix file)
  (propose 3 (fmt "给出修复以下代码的 3 个不同思路:\n{}" (read-files (list file)))))
