;; M3 示例:非确定性求值与回溯(amb / require)。
;; 运行:make run FILE=examples/amb.piper

;; 1) 勾股数:在三层 amb 上加约束,自动回溯搜出第一组解
(define (pythag hi)
  (let ((i (an-integer-between 1 hi)))
    (let ((j (an-integer-between i hi)))
      (let ((k (an-integer-between j hi)))
        (require (= (+ (* i i) (* j j)) (* k k)))
        (list i j k)))))

(display "勾股数(<=20): ") (display (pythag 20)) (newline)   ; (3 4 5)

;; 2) 跨多个 amb 的约束求解
(define result
  (let ((a (amb 1 2 3 4 5))
        (b (amb 1 2 3 4 5)))
    (require (= (* a b) 12))
    (require (< a b))
    (list a b)))
(display "a*b=12 且 a<b: ") (display result) (newline)   ; (3 4)

;; 3) amb* 在运行时列表间选择 —— 这正是 goal 里"LLM 给候选、回溯择优"的形态:
;;    把下面的 (list ...) 换成 (eval (llm-code "返回若干策略的 list")) 即接入 LLM。
(define strat
  (let ((s (amb* (list 'merge 'rebase 'squash 'cherry-pick))))
    (require (eq? s 'rebase))
    s))
(display "选中的策略: ") (display strat) (newline)         ; rebase
