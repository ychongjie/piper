;; goal 示例:让 agent 猜出密码——它用工具试探、根据反馈自己推理逼近。
;; 运行:make run FILE=examples/goal-guess.piper
;; 核心词:goal。tools 是能力白名单——agent 生成的代码只能调 guess(碰不到 secret)。

(define secret 73)
(define found  #f)

(define (guess n)
  (cond ((= n secret) (set! found #t) 'correct)
        ((< n secret) 'low)
        (else 'high)))

(define result
  (goal "猜出 1 到 100 之间的密码:每步用 (guess n) 试一个数,返回 low/high/correct;请二分逼近"
    (success?  (lambda () found))
    (tools     (list (cons 'guess guess)))
    (max-steps 12)))

(newline)
(display (fmt "结果:{}(密码 {})\n" (car result) secret))
