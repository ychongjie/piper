;; 开源模型评审团(纯认知层,需要 llm CLI + 几个开源模型已配)。
;; 运行:make run FILE=examples/panel.piper
;;
;; 同一问题 fan-out 给一组 model,各答一版,用 judge 按"准确+简洁"择优。
;; 用到的核心词汇:model(认知 worker)、fan-out、judge。没有副作用、没有 pi。

(define models (list "deepseek-v4-pro" "kimi2.6" "deepseek-v4-flash"))
(define q "用一两句话解释什么是尾递归(tail recursion),要求准确、简洁。")

(define answers (fan-out (map model models) q))               ; 各 model 各答一版
(define scored  (map (lambda (a) (cons a (judge "准确且简洁" a))) answers))

(display "== 评审团各模型的回答与得分 ==\n")
(for-each (lambda (p)
            (display "  ") (display (car p))
            (display " [") (display (cdr (cdr p))) (display " 分]: ")
            (display (car (cdr p))) (newline))
          (zip models scored))

(define winner
  (car (foldl (lambda (p b) (if (> (cdr p) (cdr b)) p b)) (car scored) (cdr scored))))
(newline)
(display "== 择优 ==\n") (display winner) (newline)
