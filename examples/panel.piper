;; 开源模型评审团(认知层示例,需要 llm CLI + 几个开源模型已配)。
;; 运行:make run FILE=examples/panel.piper
;;
;; 纯【认知层】编排:同一问题 fan-out 给一组开源模型(ensemble),各答一版,
;; 再用认知层裁判(judge)按"准确+简洁"打分择优。没有副作用、没有 pi——
;; 这是"多个脑子合议",和执行层(pi 派 agent 干活)是不同层级。

(define models (list "kimi2.6" "deepseek-v4-pro" "deepseek-v4-flash"))
(define q "用一两句话解释什么是尾递归(tail recursion),要求准确、简洁。")
(define crit "准确且简洁")

(define answers (ensemble models q))                         ; 各模型各答一版
(define scored  (map (lambda (a) (cons a (judge crit a))) answers))  ; 裁判打分

(display "== 评审团各模型的回答与得分 ==\n")
(for-each (lambda (p)
            (display "  ") (display (car p))
            (display " [") (display (cdr (cdr p))) (display " 分]: ")
            (display (car (cdr p))) (newline))
          (zip models scored))

(define best
  (car (foldl (lambda (p b) (if (> (cdr p) (cdr b)) p b)) (car scored) (cdr scored))))

(newline)
(display "== 择优后的最佳回答 ==\n")
(display best) (newline)
